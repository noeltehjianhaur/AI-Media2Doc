# Primary LLM/ASR provider: Google Gemini (required).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=
# Explicit comma-separated allow-lists. Defaults to GEMINI_MODEL_ID when omitted.
GEMINI_ASR_MODELS=
GEMINI_VIDEO_MODELS=
GEMINI_TEXT_MODELS=
# Optional Google Cloud quota telemetry. The access token needs read-only Service Usage permissions.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_ACCESS_TOKEN=
# Optional fallback provider. Uses an OpenAI-compatible Chat Completions API.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=openai/gpt-4o-mini
# Optional ASR fallback. Must be an OpenRouter model that accepts audio input.
OPENROUTER_ASR_MODEL_ID=
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODELS=
OPENROUTER_ASR_MODELS=
# Optional account-credit lookup; keep this server-side.
OPENROUTER_MANAGEMENT_KEY=
# S3-compatible object storage (e.g. Cloudflare R2).
STORAGE_ACCESS_KEY=xxx
STORAGE_SECRET_KEY=xxx
STORAGE_ENDPOINT=xxx
STORAGE_REGION=xxx
STORAGE_BUCKET=xxx
# Optional Cloudflare R2 account analytics (read-only token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
# Provider telemetry cache and maximum concurrent model calls.
PROVIDER_USAGE_CACHE_SECONDS=60
MAX_CONCURRENT_MODEL_REQUESTS=2
MAX_VIDEO_SIZE_MB=200
CONFIGURE_R2_LIFECYCLE=false
# Optional output publication. Disabled unless explicitly enabled.
GITHUB_OUTPUT_ENABLED=false
GITHUB_OUTPUT_REPOSITORY=noeltehjianhaur/AI-Media2Doc-Output
GITHUB_OUTPUT_BRANCH=main
GITHUB_OUTPUT_TOKEN=
# 如果不需要密码访问，请留空或者删除此行
WEB_ACCESS_PASSWORD=