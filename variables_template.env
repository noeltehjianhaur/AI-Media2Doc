# Primary LLM/ASR provider: Google Gemini (required).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=
# Optional fallback provider. Uses an OpenAI-compatible Chat Completions API.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=openai/gpt-4o-mini
# Optional ASR fallback. Must be an OpenRouter model that accepts audio input.
OPENROUTER_ASR_MODEL_ID=
OPENROUTER_API_KEY=
# S3-compatible object storage (e.g. Cloudflare R2).
STORAGE_ACCESS_KEY=xxx
STORAGE_SECRET_KEY=xxx
STORAGE_ENDPOINT=xxx
STORAGE_REGION=xxx
STORAGE_BUCKET=xxx
# 如果不需要密码访问，请留空或者删除此行
WEB_ACCESS_PASSWORD=